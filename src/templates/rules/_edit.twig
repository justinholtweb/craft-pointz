{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set selectedSubnavItem = 'rules' %}
{% set fullPageForm = true %}
{% set crumbs = [
    { label: "Pointz"|t('pointz'), url: url('pointz') },
    { label: "Earning rules"|t('pointz'), url: url('pointz/rules/' ~ store.handle) }
] %}

{# This screen is rendered by Pointz's own controller, not by `settingsHtml()`, so nothing
   namespaces its inputs and the field names here are the names that post. #}

{% block content %}
    <input type="hidden" name="action" value="pointz/rules/save">
    {{ redirectInput('pointz/rules/' ~ store.handle) }}
    <input type="hidden" name="storeId" value="{{ store.id }}">
    {% if rule.id %}<input type="hidden" name="id" value="{{ rule.id }}">{% endif %}

    {{ forms.textField({
        first: true,
        label: "Name"|t('pointz'),
        instructions: "What this rule is called in the control panel — and, if a template prints it, on the site."|t('pointz'),
        id: 'name',
        name: 'name',
        value: rule.name,
        required: true,
        errors: rule.getErrors('name')
    }) }}

    {{ forms.textField({
        label: "Handle"|t('pointz'),
        id: 'handle',
        name: 'handle',
        class: 'code',
        autocorrect: false,
        autocapitalize: false,
        value: rule.handle,
        required: true,
        errors: rule.getErrors('handle')
    }) }}

    {{ forms.selectField({
        label: "Earned for"|t('pointz'),
        instructions: isPro ? null : "Pro adds rules for approved reviews, birthdays, reaching a points balance and custom events such as a newsletter signup."|t('pointz'),
        id: 'event',
        name: 'event',
        options: eventOptions,
        value: rule.event,
        errors: rule.getErrors('event')
    }) }}

    {% if isPro %}
        <div data-events="custom">
            {{ forms.textField({
                label: "Event handle"|t('pointz'),
                instructions: "Which event pays out. `formie:newsletter` answers the Formie form with that handle, `dispatch:club` a signup to that Dispatch list, and anything else is yours to fire from a module with `Plugin::getInstance()->getRewards()->awardEvent($user, 'yourHandle')`. End it in `*` to match several, like `formie:*`. Each customer is paid once per rule unless your code passes a reference."|t('pointz'),
                id: 'eventHandle',
                name: 'eventHandle',
                class: 'code',
                value: rule.eventHandle,
                errors: rule.getErrors('eventHandle')
            }) }}

            {{ forms.lightswitchField({
                label: "Pay people without an account"|t('pointz'),
                instructions: "When the event comes with an email address nobody has an account for — a newsletter signup, say — create an inactive account for it, the way Commerce does for a guest checkout, and pay that. If they register later with the same address, it's the same account and the reward is waiting. Without this, an unknown email is ignored."|t('pointz'),
                id: 'createAccount',
                name: 'createAccount',
                on: rule.createAccount
            }) }}
        </div>

        <div data-events="threshold">
            {{ forms.textField({
                type: 'number',
                step: 'any',
                label: "Balance"|t('pointz'),
                instructions: "Fires when the customer's available {points} reach this."|t('pointz', { points: settings.pointsLabelPlural }),
                id: 'thresholdPoints',
                name: 'thresholdPoints',
                value: rule.thresholdPoints,
                size: 10,
                errors: rule.getErrors('thresholdPoints')
            }) }}

            {{ forms.lightswitchField({
                label: "Spend the points"|t('pointz'),
                instructions: "On: the balance pays for the reward and starts again, so the rule fires every time it is reached. Off: the balance is left alone and the rule fires once per customer, ever. For tiers, put the higher rule first and switch on “stop after this one”."|t('pointz'),
                id: 'thresholdSpend',
                name: 'thresholdSpend',
                on: rule.thresholdSpend
            }) }}
        </div>

        <div data-events="birthday">
            {{ forms.selectField({
                label: "Birthday field"|t('pointz'),
                instructions: "The user field holding the customer's date of birth. Birthdays are paid by `pointz/sweep/run`, so schedule it daily; a missed night is caught up for up to six days."|t('pointz'),
                id: 'birthdayField',
                name: 'birthdayField',
                options: birthdayFieldOptions,
                value: rule.birthdayField,
                errors: rule.getErrors('birthdayField')
            }) }}
        </div>

        <div data-events="review">
            {% if not starsInstalled %}
                <p class="warning with-icon">{{ "Review rules are paid by Stars, which isn't installed. This rule won't fire until it is."|t('pointz') }}</p>
            {% endif %}

            {{ forms.lightswitchField({
                label: "Only reviews with written text"|t('pointz'),
                instructions: "Stars always stores a rating, so this is what separates a review from a click on a star."|t('pointz'),
                id: 'reviewRequiresText',
                name: 'reviewRequiresText',
                on: rule.reviewRequiresText
            }) }}

            {{ forms.lightswitchField({
                label: "Only products the customer bought"|t('pointz'),
                instructions: "The reviewed entry must be a product from one of the customer's completed orders, or related to one in either direction. The reviewer is matched to a customer by email."|t('pointz'),
                id: 'reviewPurchasedOnly',
                name: 'reviewPurchasedOnly',
                on: rule.reviewPurchasedOnly
            }) }}
        </div>

        <div data-events="order">
        {{ forms.selectField({
            label: "Applies"|t('pointz'),
            instructions: "A per-line-item rule runs once for every matching product in the order, which is how “double points on outdoor gear” is written."|t('pointz'),
            id: 'scope',
            name: 'scope',
            options: scopeOptions,
            value: rule.scope,
            errors: rule.getErrors('scope')
        }) }}
        </div>

        {{ forms.selectField({
            label: "Awards"|t('pointz'),
            id: 'currency',
            name: 'currency',
            options: currencyOptions,
            value: rule.currency,
            errors: rule.getErrors('currency')
        }) }}

        <div data-currencies="coupon">
            {{ forms.selectField({
                label: "Coupon"|t('pointz'),
                id: 'couponType',
                name: 'couponType',
                options: couponTypeOptions,
                value: rule.couponType,
                errors: rule.getErrors('couponType')
            }) }}

            {{ forms.textField({
                type: 'number',
                step: 'any',
                label: "Coupon value"|t('pointz'),
                instructions: "A percentage, or an amount in the store's currency. Each coupon is a single-use code on one Commerce discount this rule owns, and only discounts the order of the customer it was issued to."|t('pointz'),
                id: 'couponAmount',
                name: 'couponAmount',
                value: rule.couponAmount,
                size: 8,
                errors: rule.getErrors('couponAmount')
            }) }}

            {{ forms.textField({
                type: 'number',
                label: "Coupon valid for"|t('pointz'),
                instructions: "Empty for a coupon that never expires. Expired codes are deleted from Commerce by `pointz/sweep/run`."|t('pointz'),
                id: 'couponValidDays',
                name: 'couponValidDays',
                value: rule.couponValidDays,
                size: 6,
                unit: "days"|t('pointz'),
                errors: rule.getErrors('couponValidDays')
            }) }}

            {{ forms.textField({
                type: 'number',
                label: "Remind before expiry"|t('pointz'),
                instructions: "Emails the customer this many days before the coupon expires. Empty for no reminder."|t('pointz'),
                id: 'couponRemindDays',
                name: 'couponRemindDays',
                value: rule.couponRemindDays,
                size: 6,
                unit: "days"|t('pointz'),
                errors: rule.getErrors('couponRemindDays')
            }) }}

            {{ forms.lightswitchField({
                label: "Email the coupon"|t('pointz'),
                instructions: "Sends the code when it is issued. Both emails are edited under Utilities → System Messages."|t('pointz'),
                id: 'couponNotify',
                name: 'couponNotify',
                on: rule.couponNotify
            }) }}

            {% if couponDiscount %}
                <p class="light">
                    {{ "Codes are issued against the discount {link}. Narrow it there if you like — excluded products, a minimum order — but change the value here: a new value starts a new discount, so codes already issued keep theirs."|t('pointz', {
                        link: tag('a', { href: couponDiscount.cpEditUrl, text: couponDiscount.name })
                    })|raw }}
                </p>
            {% endif %}
        </div>
    {% endif %}

    <div data-events="order">
    {{ forms.selectField({
        label: "Calculated as"|t('pointz'),
        id: 'calculation',
        name: 'calculation',
        options: calculationOptions,
        value: rule.calculation,
        toggle: true,
        targetPrefix: 'calc-'
    }) }}

    <div id="calc-ratio" class="{{ rule.calculation == 'ratio' ? '' : 'hidden' }}">
        {{ forms.selectField({
            label: "Based on"|t('pointz'),
            instructions: "Which figure the rate is applied to. A line-item rule can only use a line item's own figures."|t('pointz'),
            id: 'basis',
            name: 'basis',
            options: basisOptions,
            value: rule.basis,
            errors: rule.getErrors('basis')
        }) }}
    </div>
    </div>

    <div data-currencies="points credit">
    {{ forms.textField({
        type: 'number',
        step: 'any',
        label: "Rate"|t('pointz'),
        instructions: "For a rate: how much is awarded per unit of the figure above. For a fixed award, and for anything that is not an order: the whole amount."|t('pointz'),
        id: 'rate',
        name: 'rate',
        value: rule.rate,
        size: 10,
        errors: rule.getErrors('rate')
    }) }}

    {{ forms.selectField({
        label: "Rounding"|t('pointz'),
        instructions: "Points are whole things, so a rate that lands on 2.5 has to go somewhere. Down is the default because nobody complains about the number they were shown."|t('pointz'),
        id: 'rounding',
        name: 'rounding',
        options: roundingOptions,
        value: rule.rounding
    }) }}
    </div>

    {% if isPro %}
        <div data-currencies="points credit">
        {{ forms.textField({
            type: 'number',
            step: 'any',
            label: "Multiplier"|t('pointz'),
            instructions: "Applied on top of the rate. Leave at 1 normally, and raise it for a promotion so the rate itself never has to be edited back afterwards."|t('pointz'),
            id: 'multiplier',
            name: 'multiplier',
            value: rule.multiplier,
            size: 6,
            errors: rule.getErrors('multiplier')
        }) }}
        </div>

        <hr>
        <h2>{{ "Limits"|t('pointz') }}</h2>

        <div data-events="order">
        {{ forms.textField({
            type: 'number',
            step: 'any',
            label: "Minimum award"|t('pointz'),
            instructions: "Raise anything this rule awards to at least this. Empty for no floor."|t('pointz'),
            id: 'minAward',
            name: 'minAward',
            value: rule.minAward,
            size: 8,
            errors: rule.getErrors('minAward')
        }) }}

        {{ forms.textField({
            type: 'number',
            step: 'any',
            label: "Maximum award"|t('pointz'),
            instructions: "The most this rule can award on one order. A per-line-item rule shares this across its lines, so the cap is a cap on the rule rather than on each product."|t('pointz'),
            id: 'maxAward',
            name: 'maxAward',
            value: rule.maxAward,
            size: 8,
            errors: rule.getErrors('maxAward')
        }) }}
        </div>

        <div data-currencies="points credit">
        {{ forms.textField({
            type: 'number',
            step: 'any',
            label: "Maximum per customer"|t('pointz'),
            instructions: "Across every order, inside the period below. Empty for no cap."|t('pointz'),
            id: 'maxPerUser',
            name: 'maxPerUser',
            value: rule.maxPerUser,
            size: 8,
            errors: rule.getErrors('maxPerUser')
        }) }}

        {{ forms.selectField({
            label: "Counted"|t('pointz'),
            id: 'maxPerUserPeriod',
            name: 'maxPerUserPeriod',
            options: periodOptions,
            value: rule.maxPerUserPeriod
        }) }}

        {{ forms.textField({
            type: 'number',
            label: "Expires after"|t('pointz'),
            instructions: "Overrides the site-wide expiry for value this rule awards. Empty follows the settings."|t('pointz'),
            id: 'expireAfterDays',
            name: 'expireAfterDays',
            value: rule.expireAfterDays,
            size: 6,
            unit: "days"|t('pointz'),
            errors: rule.getErrors('expireAfterDays')
        }) }}
        </div>

        <div data-events="order">
        {{ forms.lightswitchField({
            label: "First order only"|t('pointz'),
            instructions: "Only awards on a customer's first completed order in this store."|t('pointz'),
            id: 'firstOrderOnly',
            name: 'firstOrderOnly',
            on: rule.firstOrderOnly
        }) }}
        </div>

        {{ forms.lightswitchField({
            label: "Stop after this one"|t('pointz'),
            instructions: "No later rule runs on an order this one matched. How an exclusive promotion is written."|t('pointz'),
            id: 'stopProcessing',
            name: 'stopProcessing',
            on: rule.stopProcessing
        }) }}

        <hr>
        <h2>{{ "Campaign window"|t('pointz') }}</h2>

        {{ forms.dateTimeField({
            label: "Starts"|t('pointz'),
            id: 'dateFrom',
            name: 'dateFrom',
            value: rule.dateFrom,
            errors: rule.getErrors('dateFrom')
        }) }}

        {{ forms.dateTimeField({
            label: "Ends"|t('pointz'),
            id: 'dateTo',
            name: 'dateTo',
            value: rule.dateTo,
            errors: rule.getErrors('dateTo')
        }) }}

        <hr>
        <h2>{{ "Conditions"|t('pointz') }}</h2>
        <p class="light">{{ "An empty condition matches everything."|t('pointz') }}</p>

        <div data-events="order">
        {{ forms.field({
            label: "Matching orders"|t('pointz'),
            instructions: "Checked against the finished order, so order status, total paid and payment gateway are all fair game here."|t('pointz')
        }, rule.getOrderCondition().getBuilderHtml()) }}
        </div>

        {{ forms.field({
            label: "Matching customers"|t('pointz'),
            instructions: "How a rule is limited to a customer group."|t('pointz')
        }, rule.getUserCondition().getBuilderHtml()) }}

        <div id="condition-purchasable" data-events="order" class="{{ rule.scope == 'lineItem' ? '' : 'hidden' }}">
            {{ forms.field({
                label: "Matching products"|t('pointz'),
                instructions: "Only used by a per-line-item rule. A purchasable that is not an element cannot be matched by a condition, so a conditional rule skips it."|t('pointz')
            }, rule.getPurchasableCondition().getBuilderHtml()) }}
        </div>
    {% endif %}

    {{ forms.lightswitchField({
        label: "Enabled"|t('pointz'),
        instructions: "A new rule starts switched off. Nothing is awarded until somebody has read the numbers."|t('pointz'),
        id: 'enabled',
        name: 'enabled',
        on: rule.enabled
    }) }}
{% endblock %}

{% if isNew %}
    {% js %}
        new Craft.HandleGenerator('#name', '#handle');
    {% endjs %}
{% endif %}

{% js %}
// Each trigger has its own settings and its own choice of what it can award. Showing only the
// ones that apply keeps a review rule from looking like it has an order total to multiply.
(function() {
    var event = document.getElementById('event');
    var currency = document.getElementById('currency');
    var allowed = {{ currenciesByEvent|json_encode|raw }};

    function apply() {
        var ev = event ? event.value : 'order';
        var cur = currency ? currency.value : 'points';

        if (currency && allowed[ev]) {
            Array.prototype.forEach.call(currency.options, function(option) {
                var ok = allowed[ev].indexOf(option.value) !== -1;
                option.hidden = !ok;
                option.disabled = !ok;
            });

            if (allowed[ev].indexOf(cur) === -1) {
                currency.value = allowed[ev][0];
                cur = currency.value;
            }
        }

        document.querySelectorAll('[data-events]').forEach(function(el) {
            var on = el.getAttribute('data-events').split(' ').indexOf(ev) !== -1;
            el.classList.toggle('pointz-off', !on);
        });

        document.querySelectorAll('[data-currencies]').forEach(function(el) {
            var on = el.getAttribute('data-currencies').split(' ').indexOf(cur) !== -1;
            el.classList.toggle('pointz-off-currency', !on);
        });
    }

    if (event) { event.addEventListener('change', apply); }
    if (currency) { currency.addEventListener('change', apply); }
    apply();
})();
{% endjs %}

{% css %}
.pointz-off, .pointz-off-currency { display: none; }
{% endcss %}

{% js %}
// The basis options depend on the scope, and offering a combination validation would reject is a
// way of making a rule that silently awards nothing.
(function() {
    var scope = document.getElementById('scope');
    var basis = document.getElementById('basis');
    var purchasable = document.getElementById('condition-purchasable');

    if (!scope || !basis) {
        return;
    }

    scope.addEventListener('change', function() {
        if (purchasable) {
            purchasable.classList.toggle('hidden', scope.value !== 'lineItem');
        }

        Craft.sendActionRequest('POST', 'pointz/rules/bases', { data: { scope: scope.value } })
            .then(function(response) {
                var current = basis.value;
                basis.innerHTML = '';

                response.data.options.forEach(function(option) {
                    var element = document.createElement('option');
                    element.value = option.value;
                    element.textContent = option.label;
                    element.selected = option.value === current;
                    basis.appendChild(element);
                });
            });
    });
})();
{% endjs %}
