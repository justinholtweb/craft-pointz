{% extends "_layouts/cp" %}

{% set title = "Ledger"|t('pointz') %}
{% set selectedSubnavItem = 'ledger' %}

{% block actionButton %}
    {% if plugin.isPro() %}
        <a class="btn" href="{{ url('pointz/ledger/export', { store: store.handle, kind: kind, currency: currency }) }}">{{ "Export CSV"|t('pointz') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    <form method="get" action="{{ url('pointz/ledger') }}" class="flex" style="margin-bottom: 14px; flex-wrap: wrap;">
        {% if stores|length > 1 %}
            <select name="store" class="select">
                {% for s in stores %}
                    <option value="{{ s.handle }}"{{ s.id == store.id ? ' selected' : '' }}>{{ s.name }}</option>
                {% endfor %}
            </select>
        {% else %}
            <input type="hidden" name="store" value="{{ store.handle }}">
        {% endif %}

        <select name="kind" class="select">
            <option value="">{{ "Every movement"|t('pointz') }}</option>
            {% for value, label in kinds %}
                <option value="{{ value }}"{{ value == kind ? ' selected' : '' }}>{{ label }}</option>
            {% endfor %}
        </select>

        <select name="currency" class="select">
            <option value="">{{ "Points and credit"|t('pointz') }}</option>
            {% for value, label in currencies %}
                <option value="{{ value }}"{{ value == currency ? ' selected' : '' }}>{{ label }}</option>
            {% endfor %}
        </select>

        <button type="submit" class="btn">{{ "Filter"|t('pointz') }}</button>
    </form>

    {% if transactions|length %}
        <table class="data fullwidth collapsible">
            <thead>
                <tr>
                    <th scope="col">{{ "When"|t('pointz') }}</th>
                    <th scope="col">{{ "Customer"|t('pointz') }}</th>
                    <th scope="col">{{ "What"|t('pointz') }}</th>
                    <th scope="col">{{ "Amount"|t('pointz') }}</th>
                    <th scope="col">{{ "Balance"|t('pointz') }}</th>
                    <th scope="col">{{ "Order"|t('pointz') }}</th>
                    <th scope="col">{{ "Note"|t('pointz') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for transaction in transactions %}
                    {% set customer = transaction.user %}
                    <tr>
                        <td class="light">{{ transaction.dateCreated|datetime('short') }}</td>
                        <th scope="row">
                            {% if customer %}
                                <a href="{{ url('pointz/balances/' ~ customer.id, { store: store.handle }) }}">{{ customer.uiLabel }}</a>
                            {% else %}
                                <span class="light">{{ "Deleted customer"|t('pointz') }}</span>
                            {% endif %}
                        </th>
                        <td>
                            {{ transaction.kindLabel }}
                            {% if transaction.isCredit() %}<span class="light">({{ settings.creditLabel }})</span>{% endif %}
                            {% if transaction.status == 'pending' %}<span class="light">({{ "pending"|t('pointz') }})</span>{% endif %}
                        </td>
                        <td><strong>{{ transaction.amount > 0 ? '+' : '' }}{{ plugin.redemption.format(transaction.amount) }}</strong></td>
                        <td class="light">{{ plugin.redemption.format(transaction.balanceAfter) }}</td>
                        <td>
                            {% set order = transaction.order %}
                            {% if order %}<a href="{{ order.cpEditUrl }}">{{ order.reference ?: order.shortNumber }}</a>{% else %}—{% endif %}
                        </td>
                        <td class="light">{{ transaction.note ?: '—' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% set pages = (total / perPage)|round(0, 'ceil') %}
        {% if pages > 1 %}
            <nav class="flex" style="margin-top: 14px;">
                {% if page > 1 %}
                    <a class="btn" href="{{ url('pointz/ledger', { store: store.handle, kind: kind, currency: currency, page: page - 1 }) }}">{{ "Previous"|t('pointz') }}</a>
                {% endif %}
                <span class="light" style="align-self: center;">{{ "Page {page} of {pages}"|t('pointz', { page: page, pages: pages }) }}</span>
                {% if page < pages %}
                    <a class="btn" href="{{ url('pointz/ledger', { store: store.handle, kind: kind, currency: currency, page: page + 1 }) }}">{{ "Next"|t('pointz') }}</a>
                {% endif %}
            </nav>
        {% endif %}
    {% else %}
        <p>{{ "Nothing has moved yet."|t('pointz') }}</p>
    {% endif %}
{% endblock %}
